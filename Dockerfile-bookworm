FROM debian:bookworm-slim

# Install only the minimal packages required to run an SSH server and the
# corosync qnet daemon.  Supervisor has been removed because a custom
# entrypoint script now handles process management based on environment
# variables.
# Use apt-get and avoid unnecessary full upgrades.  Only install
# required packages and remove apt lists to reduce image size.
RUN apt-get update \
    && apt-get install --no-install-recommends -y openssh-server corosync-qnetd \
    && rm -rf /var/lib/apt/lists/*

# Create an unprivileged user and group for running corosync-qnetd.  This
# follows Proxmox's recommendation to run any QDevice daemon as an
# unprivileged user【59303623124675†L1490-L1496】.  The user's home directory
# is set to /var/lib/qnetd and this directory is owned accordingly.
RUN groupadd -r coroqnetd && useradd -r -g coroqnetd -d /var/lib/qnetd -s /usr/sbin/nologin coroqnetd \
    && mkdir -p /var/lib/qnetd \
    && chown coroqnetd:coroqnetd /var/lib/qnetd

# Proxmox relies upon SSH between cluster nodes using the root account.
# PermitRootLogin is explicitly enabled here.  The SSH daemon is
# controlled indirectly via the QDEVICE_MODE environment variable in
# the entrypoint; there is no longer an SSHD_ENABLED toggle.
RUN sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config

# Create directories used by the SSH daemon at runtime.
RUN mkdir -p /run/sshd

# Add our custom entrypoint script. This script performs first-boot
# initialization, such as setting the root password, installing
# authorized keys and generating SSH host keys if necessary. It then
# conditionally starts sshd and corosync-qnetd based on environment
# variables.
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Copy the environment validation script.  This optional script is
# executed by the entrypoint to warn about misconfigurations.  It
# exits with status 0 on warnings and non-zero on fatal errors.
COPY validate_env.sh /usr/local/bin/validate_env.sh
RUN chmod +x /usr/local/bin/validate_env.sh

# Expose the default SSH and qnetd ports.  Runtime firewall rules or
# container configuration can selectively expose these ports.
EXPOSE 22
EXPOSE 5403

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# Define a simple healthcheck which reports container health by
# verifying that the corosync-qnetd process is running.  Healthchecks
# are optional in Compose but recommended for production deployments.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD pgrep corosync-qnetd >/dev/null 2>&1 || exit 1


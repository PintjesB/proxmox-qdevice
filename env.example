# Example environment configuration for proxmox-qdevice

# This file demonstrates how to configure the container via
# environment variables.  Copy it to `.env` or inject the
# variables directly via your orchestration platform.  All values
# here are examples and should be customised for your environment.

# Mode of operation: `setup`, `runtime` or `auto`.  In `setup` mode the SSH
# daemon is automatically enabled to allow `pvecm qdevice setup`.  In
# `runtime` mode only the QNet daemon runs.  In `auto` mode SSH will
# remain enabled until a qdevice configuration is detected; on
# subsequent starts it will be disabled automatically.
QDEVICE_MODE=setup

# Root password for the container.  Prefer to mount a secret file
# instead of setting the password inline.  Alternatively set
# ROOT_PASSWORD_FILE to the path of the secret file.  The
# legacy variable NEW_ROOT_PASSWORD is still supported.
ROOT_PASSWORD=changeMe
# ROOT_PASSWORD_FILE=/run/secrets/root_password

# SSH authorised keys for the root user.  Either specify the key(s)
# directly or provide a file containing one key per line.  Keys from
# the file take precedence over this variable.
# ROOT_AUTHORIZED_KEYS="ssh-ed25519 AAAA... user@example"
# ROOT_AUTHORIZED_KEYS_FILE=/run/secrets/root_authorized_keys

# The container will automatically generate missing SSH host keys and
# store them in /etc/ssh.  Persist /etc/ssh to retain host identity.

# Optional user and group to run the QNet daemon as.  Running as an
# unprivileged user is recommended by Proxmox for improved
# security.  If unset or set to `root` the daemon runs as root.
# QNETD_USER=coroqnetd
# QNETD_GROUP=coroqnetd
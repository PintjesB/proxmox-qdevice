# Runtime-only, hardened distroless image for corosync-qnetd.
#
# This variant intentionally does not include SSH, a shell, chpasswd,
# ssh-keygen, runuser, or the setup entrypoint.  It is meant for the
# final qnetd runtime after the qdevice has already been provisioned.
# Use Dockerfile-bookworm or Dockerfile-trixie for setup/auto mode.

FROM debian:bookworm-slim AS builder

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        corosync-qnetd \
        procps; \
    rm -rf /var/lib/apt/lists/*; \
    install -d /out/usr/bin /out/usr/sbin /out/etc /out/var/lib/qnetd /out/etc/corosync; \
    qnetd="$(command -v corosync-qnetd)"; \
    pgrep="$(command -v pgrep)"; \
    install -D "$qnetd" /out/usr/bin/corosync-qnetd; \
    install -D "$qnetd" /out/usr/sbin/corosync-qnetd; \
    install -D "$pgrep" /out/usr/bin/pgrep; \
    cp /etc/passwd /out/etc/passwd; \
    cp /etc/group /out/etc/group; \
    cp /etc/nsswitch.conf /out/etc/nsswitch.conf; \
    chown -R 65532:65532 /out/var/lib/qnetd /out/etc/corosync

FROM gcr.io/distroless/base-debian12:nonroot

# Copy qnetd, pgrep, identity files and minimal state directories.
COPY --from=builder /out/ /

# Copy the shared libraries used by qnetd and pgrep.  This is less pure
# than copying an ldd-derived file list, but keeps the Dockerfile stable
# across Debian point releases while still avoiding a shell, package
# manager and generic userland in the final image.
COPY --from=builder /lib /lib
COPY --from=builder /usr/lib /usr/lib
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /etc/ssl/certs /etc/ssl/certs

# qnetd listens on TCP/5403 by default.  The port is above 1024, so it
# does not require root privileges.
EXPOSE 5403/tcp

# Run as the distroless nonroot user by default.  When mounting existing
# /etc/corosync or /var/lib/qnetd volumes, make sure the files are
# readable by uid 65532, or override the user explicitly at runtime.
USER 65532:65532

ENTRYPOINT ["/usr/bin/corosync-qnetd", "-f"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["/usr/bin/pgrep", "corosync-qnetd"]
